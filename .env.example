# Bastilla OS / SVL_System & Debian 13 — Konfiguracja Środowiskowa (.env.example)
# Wygeneruj losowe sekrety (min. 32 znaki) poleceniem:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

PORT=3000
APP_URL="MY_APP_URL"
DATA_DIR=data

# Logowanie Operatora (min. 32 znaki; przechowywane wyłącznie po stronie backendu)
SVL_OPERATOR_TOKEN=
SVL_HTTPS=false

# Podsystem Debian 13 Python API
DEBIAN13_API_PORT=8765
DEBIAN13_STATE_DIR=data/debian13_state
WORKSPACE_DIR=data/workspace

# Obserwator Hosta Linux (linux/linux-sync-agent.py)
SVL_LINUX_SYNC_TOKEN=
SVL_WORKER_TOKENS={}

# Ollama & Model 14B Vision Uncensored
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-vl:14b

# Gemini API (opcjonalny fallback po stronie serwera w AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.8-flash

# GitHub CLI (opcjonalny token do publikacji na gałąź main)
GITHUB_TOKEN=
